#!/usr/bin/env sh

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for PROJECT_CLI in \
  "$APP_HOME/node_modules/@ohos/hvigor/bin/hvigor.js" \
  "$APP_HOME/node_modules/@ohos/hvigor/hvigor/bin/hvigor.js"
do
  if [ -f "$PROJECT_CLI" ]; then
    exec node "$PROJECT_CLI" "$@"
  fi
done

for STUDIO_HOME in \
  "${DEVECO_STUDIO_HOME:-}" \
  "/opt/DevEco-Studio" \
  "/Applications/DevEco-Studio.app/Contents" \
  "/c/Program Files/Huawei/DevEco Studio"
do
  [ -n "$STUDIO_HOME" ] || continue
  STUDIO_WRAPPER="$STUDIO_HOME/tools/hvigor/bin/hvigorw"
  if [ -f "$STUDIO_WRAPPER" ]; then
    exec sh "$STUDIO_WRAPPER" "$@"
  fi
done

echo "ERROR: Hvigor was not found in node_modules or DevEco Studio." >&2
echo "Set DEVECO_STUDIO_HOME to the DevEco Studio installation directory." >&2
exit 1
